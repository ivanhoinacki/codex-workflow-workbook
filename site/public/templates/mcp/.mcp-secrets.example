# Copy to ~/.codex/.mcp-secrets.
# Never commit the real file.

# Atlassian
export ATLASSIAN_USERNAME="you@example.com"
export JIRA_API_TOKEN="REPLACE_ME"
export CONFLUENCE_API_TOKEN="REPLACE_ME"

# Datadog, only needed when not using OAuth-only setup.
export DD_SITE="datadoghq.com"
export DD_API_KEY="REPLACE_ME"
export DD_APP_KEY="REPLACE_ME"

# Local knowledge base.
export DATABASE_URL="postgresql://USER:PASSWORD@localhost:PORT/DATABASE"
# Optional. Needed only when local-le-vault is enabled.
export LOCAL_LE_VAULT_SERVER="$HOME/.codex/local-le-vault/vault_mcp_server.py"
export LOCAL_LE_VAULT_PYTHON="python3"
export LOCAL_LE_VAULT_VENV="$HOME/.local/share/le-vault/venv"
export RADAR_API_URL="http://localhost:8900"

# Optional local binaries.
export MCP_ATLASSIAN_BIN="/ABSOLUTE/PATH/TO/.venv/bin/mcp-atlassian"
export DATADOG_MCP_CLI="/ABSOLUTE/PATH/TO/datadog_mcp_cli"
